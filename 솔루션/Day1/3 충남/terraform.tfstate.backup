          "attributes": {
            "arn": "arn:aws:cloudfront::076472864721:function/wsc2026-cdn-function",
            "code": "function handler(event) {\r\n    var request = event.request;\r\n    var uri = request.uri;\r\n\r\n    if (uri.startsWith('/booking')) {\r\n        request.uri = uri.replace('/booking', '/v1/book');\r\n    }\r\n\r\n    return request;\r\n}",
            "comment": "",
            "etag": "ETVPDKIKX0DER",
