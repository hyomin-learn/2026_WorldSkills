    {
      "module": "module.cloudfront[\"apdev-cdn\"]",
      "mode": "managed",
      "type": "aws_cloudfront_function",
      "name": "this",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "index_key": 0,
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::076472864721:function/apdev-cdn-function",
            "code": "function handler(event) {\r\n    var request = event.request;\r\n    var response = event.response;\r\n\r\n    if (!response.headers) {\r\n        response.headers = {};\r\n    }\r\n\r\n    var filename = request.uri.split(\"/\").pop() || \"download\";\r\n\r\n    filename = filename\r\n        .replace(/\"/g, \"_\")\r\n        .replace(/\\\\/g, \"_\")\r\n        .replace(/\\r/g, \"_\")\r\n        .replace(/\\n/g, \"_\");\r\n\r\n    response.headers[\"content-disposition\"] = {\r\n        value: 'attachment; filename=\"' + filename + '\"'\r\n    };\r\n\r\n    return response;\r\n}",
            "comment": "",
            "etag": "ETVPDKIKX0DER",
            "id": "apdev-cdn-function",
            "key_value_store_associations": null,
            "live_stage_etag": "ETVPDKIKX0DER",
